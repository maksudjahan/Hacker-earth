#include<bits/stdc++.h>
using namespace std;
int main(){
	int t;
	cin>>t;
	while(t--){
    int n;
	cin>>n;
	int i,j;
	long long a[45][45];
	memset(a,0,sizeof(a));
	for(i=0;i<n;i++){
		for(j=0;j<=i;j++){
			if(j==0||j==i) a[i][j]=1;
			else
        a[i][j]=a[i-1][j-1]+a[i-1][j];
		}
	}
	for(i=0;i<n;i++){
		for(j=0;j<=i;j++){
			cout<<a[i][j]<<" ";
		}
		cout<<'\n';
	}
	}
	cout<<endl;
}
