#include<bits/stdc++.h>
using namespace std;
int main(){
int t;
cin>>t;
while(t--){
        int n,i,j;
    cin>>n;
    char c[n][n];
    for(i=0;i<n;i++){
        for(j=0;j<n;j++){
            cin>>c[i][j];
        }
    }
    bool ok=true;

    for(i=0;i<n/2;i++){
        for(j=0;j<n/2;j++){
        if(c[i][j]!=c[n-i-1][j]){
            ok=false;
        }
        if(c[i][j]!=c[i][n-j-1]){
            ok=false;
        }
    }
}
if(!ok) cout<<"NO"<<'\n';
else
cout<<"YES"<<'\n';
}}
